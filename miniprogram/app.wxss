page{background:#f4f1fa;color:#272335;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:30rpx;line-height:1.6;box-sizing:border-box}view,text,button,input,textarea{box-sizing:border-box} .page{padding:28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));max-width:1100rpx;margin:auto;overflow-wrap:anywhere}.card{background:white;border-radius:28rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 4rpx 22rpx #38246108;min-width:0}.row{display:flex;align-items:center;flex-wrap:wrap;gap:18rpx}.stack{display:flex;flex-direction:column;gap:20rpx}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.button,button{background:#6e54a2;color:#fff;border-radius:18rpx;font-size:29rpx;padding:16rpx 20rpx;margin:10rpx 0;line-height:1.5;white-space:normal;width:100%}button::after{border:0}button[disabled]{opacity:.55}.secondary{background:#eee8f7;color:#4f397e}.settings{background:transparent;color:#655080;width:auto;margin-left:auto;padding:10rpx 14rpx}.hint{font-size:25rpx;color:#70697c}.error{background:#fff0f1;color:#a12f43;padding:20rpx;border-radius:16rpx;margin:16rpx 0}.success{background:#e9f6ef;color:#276644;padding:20rpx;border-radius:16rpx;margin:16rpx 0}.empty{color:#827a8e;padding:24rpx 0}.field{margin:18rpx 0;min-width:0}.label{display:block;font-size:27rpx;color:#554c63;margin-bottom:8rpx}input,textarea,picker{width:100%;max-width:100%;background:#f7f5fb;border:2rpx solid #e4deee;border-radius:14rpx;padding:18rpx;color:#272335}input{min-height:88rpx}textarea{min-height:160rpx}picker{min-height:82rpx}.chip{display:inline-block;background:#eee8f7;color:#624a8d;border-radius:30rpx;padding:5rpx 16rpx;font-size:24rpx;margin:5rpx}checkbox,switch{flex-shrink:0} .title{font-size:43rpx;font-weight:700;line-height:1.3;margin:12rpx 0 24rpx}.subtitle{font-size:33rpx;font-weight:650;margin-bottom:12rpx} .section-title{font-size:33rpx;font-weight:650;margin:16rpx 0} .small{font-size:25rpx}.divider{border-top:2rpx solid #eee9f4;margin:20rpx 0} .danger{background:#fff0f1;color:#a12f43} .offline{padding:16rpx;background:#fff3d8;color:#795a12;border-radius:14rpx;margin-bottom:20rpx}
