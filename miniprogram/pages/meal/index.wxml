<view class="page">
  <view class="row top"><view><text class="eyebrow">本人餐食 · 默认私有</text><view class="title">{{row ? '核对这餐' : '拍照或文字记餐'}}</view></view><button class="secondary settings" bindtap="settings">设置</button></view>
  <view wx:if="{{loading}}" class="hint">正在从服务器读取餐食与照片状态…</view><view wx:if="{{offline}}" class="error">当前离线，提交结果可能尚未确认。<button class="secondary" bindtap="retryRefresh">重试连接</button></view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="retryRefresh">刷新核对</button></view><view wx:if="{{notice}}" class="success">{{notice}}</view>
  <view wx:if="{{pendingCreate}}" class="card stack"><view class="error">上次保存结果尚未确认；只能用同一请求重试。先刷新服务器记录，避免重复新建。</view><button class="button" disabled="{{busy}}" bindtap="retryPending">按原内容重试</button></view>
  <view class="card stack"><view class="section-title">照片（可选）</view><view class="hint">只选本人照片。本机先净化为 PNG；上传也不会自动发送给 AI。照片默认私有。</view>
    <button class="button" disabled="{{busy || loading || photoPreparing || photoUploading}}" bindtap="choose">拍照／选图记餐</button>
    <view wx:if="{{photoPath}}" class="photo-row stack">
      <view class="hint">{{photoUploading ? '正在上传，本机预览保留' : photoPreparing ? '本机照片 · 未上传，正在处理' : '本机照片 · 未上传'}}</view>
      <image wx:if="{{!localPhotoError}}" class="photo-preview" src="{{photoPath}}" mode="aspectFit" bindtap="viewLocalPhoto" binderror="localPhotoFailed" />
      <view wx:if="{{localPhotoError}}" class="error">{{localPhotoError}}</view><text wx:else class="hint">点照片查看大图</text>
      <view wx:if="{{photoPending}}" class="row"><text>可不填写食物先存草稿</text><button wx:if="{{id}}" class="secondary" disabled="{{busy || photoUploading}}" bindtap="uploadPhoto">上传照片</button><button wx:else class="secondary" disabled="{{busy || photoUploading}}" bindtap="savePhotoDraft">保存照片草稿并上传</button></view>
      <button class="secondary" disabled="{{busy || photoUploading}}" bindtap="cancelPhoto">取消本机照片</button>
    </view>
    <view wx:for="{{photos}}" wx:key="id" class="photo-row stack">
      <text>{{item.deleteRequested ? '删除待确认，可重试' : item.deleting ? '待清理，可重试删除' : item.uploading ? '上传中断，可清理' : '已上传的私人照片'}}</text>
      <block wx:if="{{!item.deleting && !item.uploading}}">
        <image wx:if="{{item.previewPath}}" class="photo-preview" src="{{item.previewPath}}" mode="aspectFit" data-id="{{item.id}}" data-attempt="{{item.previewAttempt}}" bindload="photoLoaded" binderror="photoFailed" bindtap="viewPhoto" />
        <view wx:if="{{item.previewState == 'loading'}}" class="hint">正在加载私人照片…</view>
        <view wx:if="{{item.previewState == 'error'}}" class="error">私人照片加载失败：{{item.previewError}}<button class="secondary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="retryPhoto">重试加载照片</button></view>
        <text wx:if="{{item.previewState == 'ready'}}" class="hint">点照片查看大图</text>
      </block>
      <button class="secondary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="deletePhoto">{{item.deleting || item.uploading ? '重试删除' : '删除'}}</button>
    </view>
  </view>
  <view class="card stack"><view class="section-title">实际吃了什么</view><view class="hint">草稿不计入摄入；确认后仍可修正。份量、油酱、剩余由本人核对。</view><view wx:if="{{aiDraft}}" class="success">AI 草稿：{{aiDraft.status}}。{{aiDraft.uncertainty}} {{aiDraft.assumptions}}；尚未保存到实际餐食。{{aiDraft.usable ? '请核对区间后保存' : '无法可靠识别，热量不计入已知区间'}}</view>
    <view class="grid"><view><text class="label">用餐日期</text><picker mode="date" value="{{recordDate}}" bindchange="changeDate"><view class="field">{{recordDate}}</view></picker></view><view><text class="label">用餐时刻</text><picker mode="time" value="{{recordTime}}" bindchange="changeTime"><view class="field">{{recordTime}}</view></picker></view></view>
    <text class="label">餐别</text><picker range="{{kindLabels}}" value="{{kindIndex}}" data-field="kind" bindchange="select"><view class="field">{{kindLabels[kindIndex]}}</view></picker>
    <text class="label">实际吃掉比例（0–1）</text><input class="field" type="digit" value="{{form.eaten_fraction}}" data-field="eaten_fraction" bindinput="change" placeholder="例如 0.5 代表一半" />
    <view class="subhead">食物与份量</view><view wx:for="{{form.items}}" wx:key="index" wx:for-index="index" class="food-row stack"><view class="row"><text>第 {{index + 1}} 项</text><button class="secondary" data-index="{{index}}" bindtap="removeItem">移除</button></view>
      <input class="field" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="itemChange" placeholder="食物名称" />
      <view class="grid"><input class="field" value="{{item.portion}}" data-index="{{index}}" data-field="portion" bindinput="itemChange" placeholder="实际份量" /><input class="field" value="{{item.unit}}" data-index="{{index}}" data-field="unit" bindinput="itemChange" placeholder="单位，如拳/掌/碗" /></view>
      <view wx:if="{{nutritionOpen}}" class="stack"><text class="hint">热量按下方克重计算，文字份量不会自动换算。</text><view class="grid"><input class="field" type="digit" value="{{item.grams_min}}" data-index="{{index}}" data-field="grams_min" bindinput="itemChange" placeholder="重量下限 g" /><input class="field" type="digit" value="{{item.grams_max}}" data-index="{{index}}" data-field="grams_max" bindinput="itemChange" placeholder="重量上限 g" /></view><input class="field" type="digit" value="{{item.kcal_per_100g}}" data-index="{{index}}" data-field="kcal_per_100g" bindinput="itemChange" placeholder="每100g kcal" /><input class="field" value="{{item.nutrition_source}}" data-index="{{index}}" data-field="nutrition_source" bindinput="itemChange" placeholder="本人核对的标签或数据来源" /></view>
    </view><button class="secondary" bindtap="addItem">添加食物</button>
    <text class="label">烹调方式</text><textarea class="field" value="{{form.cooking}}" data-field="cooking" bindinput="change" placeholder="选填" />
    <text class="label">油和酱汁</text><textarea class="field" value="{{form.oil}}" data-field="oil" bindinput="change" placeholder="请写实际情况；未知留空" />
    <text class="label">剩余食物</text><textarea class="field" value="{{form.leftover}}" data-field="leftover" bindinput="change" placeholder="选填" />
    <button class="secondary" bindtap="nutritionToggle">{{nutritionOpen ? '收起营养标签' : '按营养标签／数据来源计算（可选）'}}</button>
    <text class="label">热量区间方式</text><picker range="{{methodLabels}}" value="{{methodIndex}}" data-field="estimate_method" bindchange="select"><view class="field">{{methodLabels[methodIndex]}}</view></picker>
    <view wx:if="{{methodIndex == 1 || methodIndex == 2 || methodIndex == 3}}" class="stack"><text class="label">油酱是否计入</text><picker range="{{additionLabels}}" value="{{additionIndex}}" data-field="additions_status" bindchange="select"><view class="field">{{additionLabels[additionIndex]}}</view></picker>
      <view wx:if="{{methodIndex == 1 || methodIndex == 3}}" class="stack"><view class="grid"><input class="field" type="digit" value="{{form.energy_min_kcal}}" data-field="energy_min_kcal" bindinput="change" placeholder="整份最低 kcal" /><input class="field" type="digit" value="{{form.energy_max_kcal}}" data-field="energy_max_kcal" bindinput="change" placeholder="整份最高 kcal" /></view><input class="field" value="{{form.estimate_source}}" data-field="estimate_source" bindinput="change" placeholder="本人核对的数据来源" /></view>
      <input class="field" value="{{form.uncertainty}}" data-field="uncertainty" bindinput="change" placeholder="不确定性说明" /><button wx:if="{{methodIndex == 2}}" class="secondary" bindtap="previewNutrition">预览计算与缺口</button><view wx:if="{{nutritionPreview}}" class="hint">{{nutritionPreview}}</view>
    </view>
    <view class="row"><text>确认实际摄入</text><switch checked="{{form.status == 'confirmed'}}" bindchange="status" /></view><view class="row"><text>与搭档共享这餐</text><switch checked="{{form.is_shared}}" bindchange="share" /></view>
    <button class="button" loading="{{busy}}" disabled="{{busy || pendingCreate}}" bindtap="save">{{row ? '保存这餐修改' : '保存这餐'}}</button><button wx:if="{{row}}" class="secondary" disabled="{{busy}}" bindtap="remove">删除这餐</button>
  </view>
  <view wx:if="{{row && aiReady}}" class="card stack"><view class="section-title">可选 AI 估算草稿</view><view class="hint">只有选择本人已授权的服务并点击请求才发送；结果仍须核对、保存。</view><picker range="{{providers}}" value="{{estimateProviderIndex}}" data-field="estimateProvider" bindchange="select"><view class="field">{{providers[estimateProviderIndex]}}</view></picker><button class="secondary" disabled="{{busy}}" bindtap="estimate">{{photos.length ? '请求图片估算草稿' : '请求文字估算草稿'}}</button></view>
  <view wx:if="{{row && row.status == 'confirmed' && dailyFlowReady}}" class="card stack"><view class="section-title">后续餐食调整</view><view class="hint">独立请求建议；本人采用前不会覆盖原计划。锁定计划不可被建议覆盖。原计划与历史版本可在今日查看。</view><picker range="{{providers}}" value="{{adjustProviderIndex}}" data-field="adjustProvider" bindchange="select"><view class="field">{{providers[adjustProviderIndex]}}</view></picker><button class="secondary" disabled="{{busy || planLocked}}" bindtap="adjust">请求后续餐食建议</button><view wx:for="{{adjustments}}" wx:key="id" class="adjust-row"><view>{{item.status}} · {{item.content.reason}}</view><view wx:for="{{item.changeViews}}" wx:for-item="change" wx:key="key" class="hint"><text>第 {{change.index + 1}} 餐：{{change.title}} {{change.time}}</text><view>食物与份量：{{change.foods}}</view><view wx:if="{{change.prep}}">做法：{{change.prep}}</view><view wx:if="{{change.purchase}}">采购／预备：{{change.purchase}}</view><view wx:if="{{change.alternative}}">替代：{{change.alternative}}</view><view wx:if="{{change.notes}}">备注：{{change.notes}}</view><view wx:if="{{change.snackReason}}">加餐原因：{{change.snackReason}}</view><view>调整原因：{{change.reason}}</view></view><view wx:for="{{item.content.warnings}}" wx:for-item="warning" wx:key="*this" class="hint">注意：{{warning}}</view><button wx:if="{{item.status == 'draft'}}" class="button" data-id="{{item.id}}" disabled="{{planLocked || busy}}" bindtap="apply">本人确认采用</button><button wx:if="{{item.status == 'applied'}}" class="secondary" data-id="{{item.id}}" disabled="{{busy}}" bindtap="undo">撤销建议</button></view></view>
  <canvas type="2d" id="photoCanvas" class="photo-canvas"></canvas>
</view>
