<view class="page">
  <view class="row top"><view><text class="eyebrow">{{day}} · 我的今天</text><view class="title">今天怎么安排</view></view><button class="secondary settings" bindtap="settings">设置</button></view>
  <view wx:if="{{loading}}" class="hint">正在从服务器读取今天的记录…</view><view wx:if="{{offline}}" class="error">当前离线，页面内容可能已过期。<button class="secondary" bindtap="retryRefresh">重试连接</button></view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="retryRefresh">重试加载</button></view><view wx:if="{{notice}}" class="success">{{notice}}</view>
  <view class="card stack quick"><view class="section-title">现在就记录</view><button class="button photo-main" bindtap="meal">拍照记餐</button><view class="grid"><button class="secondary" bindtap="weight">记录体重</button><button class="secondary" bindtap="trainingPage">进入训练</button></view></view>
  <view class="card stack"><view class="row"><view><view class="section-title">今日三餐与训练</view><view class="hint">{{planVersion ? '计划版本 ' + planVersion : '尚无今天的计划'}}{{planStale ? ' · 待更新' : ''}}{{planLocked ? ' · 已锁定' : ''}}</view></view><button class="secondary" bindtap="tomorrowPage">明日安排</button></view>
    <view wx:if="{{planVersion}}"><view>{{planSummary}}</view><view class="subhead">三餐</view><view wx:for="{{planMeals}}" wx:key="key" class="plan-meal"><text class="label">{{item.name}} {{item.time}}</text><view wx:for="{{item.foods}}" wx:for-item="food" wx:key="*this">{{food}}</view><view wx:if="{{item.prep}}" class="hint">做法：{{item.prep}}</view><view wx:if="{{item.purchase}}" class="hint">采购／预备：{{item.purchase}}</view><view wx:if="{{item.alternative}}" class="hint">替代：{{item.alternative}}</view><view wx:if="{{item.notes}}" class="hint">备注：{{item.notes}}</view><view wx:if="{{item.snackReason}}" class="hint">加餐原因：{{item.snackReason}}</view></view>
      <view class="subhead">训练</view><view>{{training.mode == 'workout' ? '安排训练' : '休息／不强制训练'}} {{training.time}} {{training.purpose}}</view>
      <view wx:if="{{training.mode == 'workout'}}"><view class="label">热身</view><view wx:for="{{training.warmup}}" wx:key="*this">{{item}}</view><view class="label">正式动作</view><view wx:for="{{training.items}}" wx:key="exercise_id">{{item.name}} · {{item.sets}} 组 × {{item.reps}} 次</view><view class="label">放松</view><view wx:for="{{training.cooldown}}" wx:key="*this">{{item}}</view></view>
    </view><view wx:else class="empty">先确认日程与规则，再查看服务器生成的完整三餐和训练。</view>
  </view>
  <view wx:if="{{planHistory.length}}" class="card stack"><view class="section-title">今天的原计划与历史版本</view><view wx:for="{{planHistory}}" wx:key="id" class="plan-meal"><text class="label">版本 {{item.version}} · {{item.trainingMode}}</text><view>{{item.summary}}</view><view wx:for="{{item.meals}}" wx:for-item="meal" wx:key="key"><text>{{meal.name}}：</text><text wx:for="{{meal.foods}}" wx:for-item="food" wx:key="*this">{{food}}　</text><view wx:if="{{meal.prep}}">做法：{{meal.prep}}</view><view wx:if="{{meal.purchase}}">采购／预备：{{meal.purchase}}</view><view wx:if="{{meal.alternative}}">替代：{{meal.alternative}}</view><view wx:if="{{meal.notes}}">备注：{{meal.notes}}</view></view></view></view>
  <view class="card stack"><view class="row"><view class="section-title">今天已确认摄入</view><button class="secondary" bindtap="meal">记录一餐</button></view><view class="intake">{{intakeText}}</view><view class="hint">{{knownCount}} 餐有区间；{{missingCount}} 餐缺少可靠估算，不按 0 计。草稿 {{draftCount}} 餐未计入。</view><view wx:for="{{confirmed}}" wx:key="id" class="row record"><view><text>{{item.name}} · 吃掉 {{item.fraction}}%</text><view class="hint">{{item.food}}</view></view><button class="secondary" data-id="{{item.id}}" bindtap="editMeal">核对</button></view></view>
  <view class="card stack"><view class="section-title">最近体重与进度</view><view>{{latestWeight}}</view><view class="hint">只显示本人实际测量。今天日程 {{scheduleCount}} 条；{{liveTraining ? '有进行中训练' : '无进行中训练'}}。</view><view class="grid"><button class="secondary" bindtap="trendsPage">查看趋势</button><button class="secondary" bindtap="recordsPage">历史记录</button></view></view>
</view>
