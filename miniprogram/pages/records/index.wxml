<view class="page"><view class="row top"><view><text class="eyebrow">本人实际记录</text><view class="title">记录</view></view><button class="secondary settings" bindtap="settings">设置</button></view>
  <view wx:if="{{loading}}" class="hint">正在读取服务器记录…</view><view wx:if="{{offline}}" class="error">当前离线，历史可能不完整。<button class="secondary" bindtap="retryRefresh">重试连接</button></view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="retryRefresh">重试加载</button></view><view wx:if="{{notice}}" class="success">{{notice}}</view>
  <view class="card stack"><view class="row"><view class="section-title">餐食</view><button class="button" bindtap="meal">拍照／文字记餐</button></view><view wx:if="{{!meals.length}}" class="empty">还没有本人餐食。</view><view wx:for="{{meals}}" wx:key="id" class="row record"><view><text>{{item.day}} · {{item.kind}} · {{item.status}}</text><view class="hint">{{item.foods}} · {{item.is_shared ? '共享' : '私有'}}</view></view><button class="secondary" data-id="{{item.id}}" bindtap="editMeal">查看</button></view></view>
  <view class="card stack"><view class="row"><view class="section-title">体重</view><button class="secondary" bindtap="weight">记录体重</button></view><view wx:if="{{!weights.length}}" class="empty">还没有实际测量。</view><view wx:for="{{weights}}" wx:key="id" class="row record"><text>{{item.day}} · {{item.kg}} kg</text><button class="secondary" bindtap="weight">修改</button></view></view>
  <view class="card stack"><view class="row"><view class="section-title">羽毛球／其他实际运动</view><button class="secondary" bindtap="newActivity">新记录</button></view><view class="hint">只记录实际完成情况，不估算卡路里。未提供的具体起止时刻保持未知；新记录默认私有。</view>
    <view wx:if="{{pendingActivity}}" class="error">上次新建结果未确认；请先刷新核对，只用原内容和同一请求编号重试。<button class="secondary" disabled="{{busy}}" bindtap="retryActivity">按原内容重试</button></view>
    <view wx:if="{{editingTimes}}" class="hint">原记录有实际起止时刻，编辑时保留：{{editingTimes}}</view><text class="label">完成日期（上海）</text><picker mode="date" value="{{activity.record_date}}" end="{{today}}" disabled="{{!!editingTimes}}" data-field="record_date" bindchange="activityChange"><view class="field">{{activity.record_date}}</view></picker>
    <text class="label">运动类型</text><picker range="{{activityLabels}}" value="{{activityTypeIndex}}" data-field="activity_type" bindchange="activitySelect"><view class="field">{{activityLabels[activityTypeIndex]}}</view></picker>
    <text class="label">实际时长（分钟）</text><input class="field" type="number" value="{{activity.duration_minutes}}" placeholder="1–1440，填写实际分钟" data-field="duration_minutes" bindinput="activityChange" />
    <text class="label">主观强度</text><picker range="{{intensityLabels}}" value="{{intensityIndex}}" data-field="intensity" bindchange="activitySelect"><view class="field">{{intensityLabels[intensityIndex]}}</view></picker>
    <text class="label">不适程度</text><picker range="{{painLabels}}" value="{{painIndex}}" data-field="pain" bindchange="activitySelect"><view class="field">{{painLabels[painIndex]}}</view></picker>
    <text class="label">备注（选填）</text><textarea class="field" value="{{activity.notes}}" maxlength="1000" placeholder="实际情况，不适可写具体表现" data-field="notes" bindinput="activityChange" />
    <view class="row"><text>与搭档共享此条</text><switch checked="{{activity.is_shared}}" bindchange="activityShare" /></view>
    <button class="button" loading="{{busy}}" disabled="{{busy || pendingActivity}}" bindtap="saveActivity">{{editingActivityId ? '保存实际运动修改' : '保存已完成运动'}}</button><button wx:if="{{editingActivityId}}" class="secondary" disabled="{{busy}}" bindtap="removeActivity">删除这条</button>
  </view>
  <view class="card stack"><view class="row"><view class="section-title">运动历史</view><button class="secondary" bindtap="training">逐组力量训练</button></view><view wx:if="{{!activities.length}}" class="empty">还没有实际完成的运动记录。</view><view wx:for="{{activities}}" wx:key="id" class="record"><view>{{item.day}} · {{item.type}} · {{item.status}}</view><view wx:if="{{item.duration}}" class="hint">实际 {{item.duration}} 分钟{{item.intensity ? ' · 强度 ' + item.intensity : ''}}{{item.pain ? ' · 不适 ' + item.pain : ''}}</view><view wx:if="{{item.notes}}" class="hint">{{item.notes}}</view><button wx:if="{{item.editable}}" class="secondary" data-id="{{item.id}}" bindtap="editActivity">编辑／删除</button></view></view>
  <button class="secondary" bindtap="trends">查看趋势与周变化</button>
</view>
