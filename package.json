{
  "name": "pair-health",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-public-config.mjs && vite build",
    "build:edge": "node scripts/build-edge.mjs",
    "build:miniapp": "node scripts/build-miniapp.mjs && node scripts/check-miniapp.mjs",
    "test:miniapp": "node scripts/check-miniapp.mjs && node --test tests/miniapp-*.test.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:concurrency": "node scripts/verify-concurrency.mjs",
    "test:concurrency:health": "node scripts/verify-health-concurrency.mjs",
    "test:auth:public": "node scripts/verify-auth-public.mjs",
    "test:cloud": "node scripts/verify-cloud.mjs",
    "test:cloud:health": "node scripts/verify-cloud-health.mjs",
    "test:browser:unconfigured": "node scripts/verify-unconfigured.mjs",
    "test:browser:mock": "node scripts/verify-ui-mock.mjs",
    "test:browser:cloud": "node scripts/verify-cloud-browser.mjs",
    "test:concurrency:ai": "node scripts/verify-ai-provider-concurrency.mjs",
    "test:concurrency:activities": "node scripts/verify-activities-concurrency.mjs",
    "test:concurrency:snapshots": "node scripts/verify-input-snapshots.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "playwright": "^1.64.0",
    "vite": "^8.3.4"
  }
}
